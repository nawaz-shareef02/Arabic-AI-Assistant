# ================================================================
# ArabIQ Backend — Environment Variables EXAMPLE FILE
# ================================================================
#
# INSTRUCTIONS
# ------------
# 1. Copy this file:  cp backend/.env.example backend/.env
# 2. Fill in ALL values marked REQUIRED.
# 3. Generate SECRET_KEY with:
#       python -c "import secrets; print(secrets.token_hex(32))"
# 4. NEVER commit backend/.env to Git — it is in .gitignore.
#
# WARNING: Do NOT use any value from this file in production.
#          Every value here is a placeholder only.
# ================================================================

# ------------------------------------------------------------------
# Project
# ------------------------------------------------------------------
PROJECT_NAME=ArabIQ
API_V1_STR=/api/v1

# ------------------------------------------------------------------
# Database  [REQUIRED]
# ------------------------------------------------------------------
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
# Do NOT use default credentials — use a strong unique password.
DATABASE_URL=postgresql://YOUR_DB_USER:YOUR_DB_PASSWORD@localhost:5432/arabiq_platform

# Database Connection Pool (P2-2 Bounded Defaults)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=10
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=True
# Application connection budget target (declarative planning metric, not a cross-process hard cap).
# SQLAlchemy QueuePool is process-local: max connections per worker = DB_POOL_SIZE + DB_MAX_OVERFLOW (10).
# Across 6 workers: 6 * 10 = 60 connections max.
# Against default PostgreSQL max_connections=100, the 40-connection difference serves as
# intentional operational headroom / application budget protection for DBA, migrations, autovacuum, backups, replication.
DB_APP_CONNECTION_BUDGET=60


# ------------------------------------------------------------------
# Security  [REQUIRED]
# ------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Minimum 32 hex characters. NEVER share or commit this value.
# Rotate this key if it is ever exposed.
SECRET_KEY=REPLACE_WITH_OUTPUT_OF_secrets_token_hex_32

JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ------------------------------------------------------------------
# Ollama (Local LLM)  [REQUIRED]
# ------------------------------------------------------------------
OLLAMA_URL=http://localhost:11434

# ------------------------------------------------------------------
# LLM Configuration (Production baseline: Qwen3-8B)
# ------------------------------------------------------------------
LLM_PROVIDER=ollama
LLM_MODEL=qwen3:8b
LLM_TIMEOUT=180
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=400
OLLAMA_KEEP_ALIVE=24h
OLLAMA_NUM_CTX=2048
OLLAMA_NUM_THREAD=0
# Bounded inference concurrency (default 1 for CPU development laptop)
OLLAMA_MAX_CONCURRENCY=1
# Max wait seconds for slot (0.0 = immediate admission control)
OLLAMA_ACQUIRE_TIMEOUT=0.0

# ------------------------------------------------------------------
# Redis
# ------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ------------------------------------------------------------------
# Qdrant Vector DB
# ------------------------------------------------------------------
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=arabiq_documents

# ------------------------------------------------------------------
# Embedding
# ------------------------------------------------------------------
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32

# ------------------------------------------------------------------
# Retrieval
# ------------------------------------------------------------------
TOP_K_RESULTS=3
ENABLE_QUERY_EXPANSION=True
ENABLE_RETRIEVAL_DEBUG=False
ENABLE_METADATA_FILTERING=True
ENABLE_RERANKER=False
HYBRID_MAX_RESULTS=10
RERANK_MAX_RESULTS=5
QUERY_EXPANSION_CACHE_TTL=3600
RRF_K=60
CONV_HISTORY_TOKEN_BUDGET=800
CONV_TITLE_MAX_WORDS=5

# ------------------------------------------------------------------
# File Upload
# ------------------------------------------------------------------
UPLOAD_DIR=uploads

# ------------------------------------------------------------------
# SMTP / Email  [REQUIRED for password reset and invitations]
# ------------------------------------------------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-email@example.com
SMTP_PASSWORD=YOUR_SMTP_PASSWORD
SMTP_FROM_EMAIL=noreply@arabiq.sa
SMTP_FROM_NAME=ArabIQ Security
SMTP_USE_TLS=True

# ------------------------------------------------------------------
# Frontend  [REQUIRED for email links to work correctly]
# ------------------------------------------------------------------
FRONTEND_URL=http://localhost:3000
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=60

# ------------------------------------------------------------------
# CORS Origins
# ------------------------------------------------------------------
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ------------------------------------------------------------------
# Trusted Hosts  [REQUIRED in production]
# ------------------------------------------------------------------
# Development: include localhost and testserver (for pytest).
# Production: set to your actual domain only. Do NOT use ["*"].
# Example production value: ALLOWED_HOSTS=["arabiq.example.com"]
ALLOWED_HOSTS=["localhost","127.0.0.1","testserver"]
