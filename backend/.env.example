# Enterprise ArabIQ Environment Template
PROJECT_NAME="ArabIQ"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/arabiq_platform"
SECRET_KEY="your-super-secret-jwt-key-here-change-in-production"
OLLAMA_URL="http://localhost:11434"
LLM_PROVIDER="ollama"
LLM_MODEL="qwen3:8b"
LLM_TIMEOUT=120
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=512
OLLAMA_KEEP_ALIVE="24h"
OLLAMA_NUM_CTX=1536
OLLAMA_NUM_THREAD=0
REDIS_URL="redis://localhost:6379/0"
QDRANT_HOST="localhost"
QDRANT_PORT=6333
QDRANT_COLLECTION="arabiq_documents"
EMBEDDING_MODEL="BAAI/bge-m3"
EMBEDDING_DEVICE="cpu"
EMBEDDING_BATCH_SIZE=32
TOP_K_RESULTS=3
CONV_HISTORY_TOKEN_BUDGET=800
CONV_TITLE_MAX_WORDS=5
UPLOAD_DIR="uploads"
