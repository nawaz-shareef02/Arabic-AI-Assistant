# ==============================================================================
# ArabIQ — Master Production Environment Template (.env)
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to .env:  cp .env.example .env
# 2. Fill in all REQUIRED values with cryptographically secure credentials.
# 3. NEVER commit the real .env to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Tier (PostgreSQL) [REQUIRED]
# ------------------------------------------------------------------------------
POSTGRES_DB=arabiq_platform
POSTGRES_USER=arabiq_admin
# Generate strong password: openssl rand -base64 32
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_GENERATED_PASSWORD

# ------------------------------------------------------------------------------
# 2. Security & Cryptography [REQUIRED]
# ------------------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_OUTPUT_OF_secrets_token_hex_32

# ------------------------------------------------------------------------------
# 3. AI / LLM Inference Tier
# ------------------------------------------------------------------------------
# In production, point to private VPC Ollama instance or internal AI cluster
OLLAMA_URL=http://host.docker.internal:11434

# ------------------------------------------------------------------------------
# 4. Domain & Network Security [REQUIRED for Production]
# ------------------------------------------------------------------------------
# Allowed origins for CORS (must match your production domains)
ALLOWED_ORIGINS=["https://app.arabiq.sa", "https://api.arabiq.sa"]

# Allowed hosts for TrustedHost middleware
ALLOWED_HOSTS=["app.arabiq.sa", "api.arabiq.sa", "reverse-proxy", "backend"]

# Frontend public API URL injected during Next.js build
NEXT_PUBLIC_API_URL=https://api.arabiq.sa
